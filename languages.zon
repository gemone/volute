            .hash = "",
        },
        .{
            .name = "css",
            .url = "git+https://github.com/tree-sitter/tree-sitter-css#6e327db4",
            .hash = "",
        },
        .{
            .name = "yaml",
            .url = "git+https://github.com/ikatyang/tree-sitter-yaml#0e36bed1",
            .hash = "",
        },
        .{
            .name = "toml",
            .url = "git+https://github.com/ikatyang/tree-sitter-toml#7cff70bb",
            .hash = "",
        },
        .{
            .name = "lua",
            .url = "git+https://github.com/tree-sitter-grammars/tree-sitter-lua#e40f5b6e",
